{
  "_comment": "Default-branch protection baseline. Review and security-review are required checks. Keep stricter live stale-review dismissal and thread-resolution controls. Factory cutover adds dedicated-App-pinned eligibility and independent producer checks through the separately reviewed factory-ruleset-plan.py output; this file does not activate the App.",
  "name": "main-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/main",
        "refs/heads/master"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "lint-test",
            "integration_id": 15368
          },
          {
            "context": "review",
            "integration_id": 15368
          },
          {
            "context": "security-review",
            "integration_id": 15368
          },
          {
            "context": "harness-validate",
            "integration_id": 15368
          },
          {
            "context": "evidence-gate",
            "integration_id": 15368
          },
          {
            "context": "adr-gate",
            "integration_id": 15368
          },
          {
            "context": "commitlint",
            "integration_id": 15368
          },
          {
            "context": "lint-exception-audit",
            "integration_id": 15368
          },
          {
            "context": "check-daily-batch",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "required_linear_history"
    }
  ],
  "bypass_actors": []
}
