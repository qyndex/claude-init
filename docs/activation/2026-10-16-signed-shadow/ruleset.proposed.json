{
  "name": "main-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/main",
        "refs/heads/master"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "dismissal_restriction": {
          "enabled": false,
          "allowed_actors": []
        },
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "lint-test",
            "integration_id": 15368
          },
          {
            "context": "harness-validate",
            "integration_id": 15368
          },
          {
            "context": "evidence-gate",
            "integration_id": 15368
          },
          {
            "context": "adr-gate",
            "integration_id": 15368
          },
          {
            "context": "commitlint",
            "integration_id": 15368
          },
          {
            "context": "lint-exception-audit",
            "integration_id": 15368
          },
          {
            "context": "check-daily-batch",
            "integration_id": 15368
          },
          {
            "context": "review",
            "integration_id": 15368
          },
          {
            "context": "security-review",
            "integration_id": 15368
          },
          {
            "context": "factory-verification",
            "integration_id": 15368
          },
          {
            "context": "factory-independent-review",
            "integration_id": 15368
          },
          {
            "context": "factory-eligibility",
            "integration_id": 5251754
          }
        ]
      }
    }
  ],
  "bypass_actors": []
}
