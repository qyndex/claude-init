name: Daily batch failure - autofix PR

# When daily-batch fails, spawn a claude --bg session to investigate and open
# a fix PR. Block manual merges until the next daily-batch passes (merge-gate.yml).
#
# Permission discipline: this workflow runs against main but only opens a PR
# (claude/daily-autofix-<date>). Never auto-merges. Requires a human approver.

on:
  workflow_run:
    workflows: ["Daily batch (8am UTC)"]
    types: [completed]

permissions:
  contents: write
  pull-requests: write
  issues: write

jobs:
  autofix:
    if: ${{ github.event.workflow_run.conclusion == 'failure' }}
    runs-on: ubuntu-latest
    timeout-minutes: 60
    env:
      RUN_ID: ${{ github.event.workflow_run.id }}
      RUN_URL: ${{ github.event.workflow_run.html_url }}
      HEAD_SHA: ${{ github.event.workflow_run.head_sha }}
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ env.HEAD_SHA }}
          fetch-depth: 0

      - name: Install claude CLI
        run: |
          if ! command -v claude >/dev/null; then
            npm install -g @anthropic-ai/claude-code
          fi

      - name: Download daily-batch logs
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          mkdir -p /tmp/daily-logs
          gh run download "$RUN_ID" --dir /tmp/daily-logs || true
          ls -la /tmp/daily-logs

      - name: Spawn claude --bg to investigate + fix
        env:
          # T-153 OAuth-everywhere: the claude CLI reads CLAUDE_CODE_OAUTH_TOKEN
          # (subscription, no metered spend). API key kept as a fallback only.
          CLAUDE_CODE_OAUTH_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          # e2e-audit failure-recovery-4: the session must push + `gh pr create` —
          # without GH_TOKEN every fix attempt died at the PR step.
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          RUN_URL_E: ${{ env.RUN_URL }}
        run: |
          # All inputs passed as env vars; never interpolated into shell strings.
          date_label=$(date +%Y-%m-%d)
          branch="claude/daily-autofix-$date_label"
          git checkout -b "$branch"

          prompt_body="Investigate the daily batch failure logged at /tmp/daily-logs/. The failing run URL is in env var RUN_URL_E. Identify the root cause, propose minimal fixes, apply them, commit with a Conventional Commit message, push, and open a PR. Do NOT auto-merge."

          claude -p --output-format stream-json \
            --max-budget-usd 5 \
            --max-turns 80 \
            --append-system-prompt "$prompt_body" \
            "Investigate the daily batch failure and open a fix PR" || echo "claude session ended; check PR"

      - name: Verify a fix PR exists (e2e-audit failure-recovery-4)
        if: always()
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          RUN_URL_BODY: ${{ env.RUN_URL }}
        run: |
          # The whole point of this workflow is the fix PR. "Session ended, no PR,
          # job green" silently broke the recovery loop — fail loudly instead.
          date_label=$(date +%Y-%m-%d)
          branch="claude/daily-autofix-$date_label"
          pr_url=$(gh pr list --head "$branch" --json url --jq '.[0].url // empty' 2>/dev/null || true)
          if [ -n "$pr_url" ]; then
            gh issue create \
              --title "Daily batch failed $date_label - autofix PR open" \
              --body "Daily batch failed. Autofix PR: $pr_url (run: $RUN_URL_BODY). Merge-gate blocks other merges until the next daily passes." \
              --label "ci,daily-autofix" || true
          else
            gh issue create \
              --title "Daily batch failed $date_label - AUTOFIX PRODUCED NO PR" \
              --body "Daily batch failed AND the autofix session ended without opening a PR (run: $RUN_URL_BODY). Manual investigation required — the recovery loop did not recover." \
              --label "ci,daily-autofix,autofix-no-pr" || true
            echo "::error::autofix session produced no PR on $branch — the recovery loop needs a human"
            exit 1
          fi
