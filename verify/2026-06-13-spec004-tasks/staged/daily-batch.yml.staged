name: Daily batch (8am UTC)

# Round 5 Batch B: heavy checks run ONCE a day at 8 am UTC instead of per-PR.
# See docs/CI-COST.md for rationale + branch protection setup.

on:
  schedule:
    - cron: "0 8 * * *"
  workflow_dispatch:
    inputs:
      skip_heavy:
        description: "Skip codeql + lighthouse (faster validation run)"
        type: boolean
        default: false

permissions:
  contents: read
  security-events: write
  actions: read
  pull-requests: write

jobs:
  codeql:
    if: ${{ inputs.skip_heavy != true }}
    uses: ./.github/workflows/codeql.yml
    permissions:
      actions: read
      contents: read
      security-events: write

  semgrep:
    uses: ./.github/workflows/semgrep.yml
    permissions:
      contents: read
      security-events: write

  lighthouse:
    if: ${{ inputs.skip_heavy != true }}
    uses: ./.github/workflows/lighthouse.yml
    permissions:
      contents: read
      pull-requests: write

  perf-budget:
    uses: ./.github/workflows/perf-budget.yml
    permissions:
      contents: read
      pull-requests: write

  license-check:
    uses: ./.github/workflows/license-check.yml
    permissions:
      contents: read

  osv-scanner:
    # Round 8 A: scan lockfiles against OSV.dev every 24h. Catches CVEs that
    # appear AFTER the lockfile was committed — the gap Dependabot can't close.
    #
    # spec 004 FINDING-16: osv-scanner-reusable.yml is a REUSABLE WORKFLOW, so it
    # must be invoked at the JOB level (jobs.osv-scanner.uses), exactly like the
    # codeql/semgrep/lighthouse siblings above — NOT as a `steps: - uses:` step.
    # The step form made the whole daily-batch.yml fail to parse ("reusable
    # workflows should be referenced at the top-level jobs.*.uses key"), which in
    # turn kept the daily-batch un-runnable and check-daily-batch permanently red.
    permissions:
      contents: read
      security-events: write
      actions: read
    uses: google/osv-scanner-action/.github/workflows/osv-scanner-reusable.yml@b8ac13f90f0ad78cebdcdbe5d39fcc8ff11301ba # main 2026-05-29
    with:
      scan-args: |-
        --recursive
        --skip-git
        ./
      fail-on-vuln: false # roll-up handles overall gate

  daily-batch-result:
    name: Daily batch result
    runs-on: ubuntu-latest
    needs: [semgrep, perf-budget, license-check, osv-scanner]
    if: always()
    env:
      SEMGREP_RESULT: ${{ needs.semgrep.result }}
      PERF_RESULT: ${{ needs.perf-budget.result }}
      LICENSE_RESULT: ${{ needs.license-check.result }}
      OSV_RESULT: ${{ needs.osv-scanner.result }}
    steps:
      - name: Roll-up status
        run: |
          # FINDING-27 (live-e2e 2026-06-13): osv-scanner is a 3rd-party reusable
          # workflow whose only output path is a SARIF upload to GitHub Code
          # Scanning — which requires Code Security / GHAS. On a repo without it
          # (e.g. private Team-plan) the job hard-fails on the upload, with no
          # input to disable it, sinking the whole daily-batch. We can't edit the
          # 3rd-party workflow, so osv-scanner is ADVISORY in the roll-up: its
          # failure is logged but does not fail daily-batch. The dependency-CVE
          # axis is still hard-gated by dependency-review (claude-security.yml).
          # Where GHAS IS enabled, promote OSV_RESULT back into the blocking set.
          status="success"
          for r in "$SEMGREP_RESULT" "$PERF_RESULT" "$LICENSE_RESULT"; do
            case "$r" in
              success|skipped) ;;
              *) status="failure" ;;
            esac
          done
          case "$OSV_RESULT" in
            success|skipped) ;;
            *) echo "::warning::osv-scanner did not pass ($OSV_RESULT) — advisory (needs Code Security/GHAS for its SARIF upload). dependency-review still hard-gates CVEs." ;;
          esac
          echo "Daily batch status: $status (osv advisory: $OSV_RESULT)"
          echo "$status" > daily-batch-status.txt
          [ "$status" = "success" ] || exit 1
      - name: Upload result
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: daily-batch-result
          path: daily-batch-status.txt
          retention-days: 30
