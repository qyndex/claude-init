name: Daily batch (8am UTC)

# Round 5 Batch B: heavy checks run ONCE a day at 8 am UTC instead of per-PR.
# See docs/CI-COST.md for rationale + branch protection setup.

on:
  schedule:
    - cron: "0 8 * * *"
  workflow_dispatch:
    inputs:
      skip_heavy:
        description: "Skip codeql (faster validation run)"
        type: boolean
        default: false

permissions:
  contents: read
  security-events: write
  actions: read
  pull-requests: write

jobs:
  codeql:
    if: ${{ inputs.skip_heavy != true }}
    uses: ./.github/workflows/codeql.yml
    permissions:
      actions: read
      contents: read
      security-events: write

  semgrep:
    uses: ./.github/workflows/semgrep.yml
    permissions:
      contents: read
      security-events: write

  # FINDING-27 (live-e2e 2026-06-13): lighthouse was REMOVED from the daily
  # batch. It is a runtime perf audit that only means anything against a
  # deployed/preview URL, which the scheduled batch never has — so here it could
  # only ever fail on a missing URL, never on a real perf regression. Run it in
  # the deploy/preview pipeline (where a URL exists), not the scheduled batch.
  # See docs/DEPLOY-INTEGRATION.md.

  perf-budget:
    uses: ./.github/workflows/perf-budget.yml
    permissions:
      contents: read
      pull-requests: write

  license-check:
    uses: ./.github/workflows/license-check.yml
    permissions:
      contents: read

  osv-scanner:
    # FINDING-27 (live-e2e 2026-06-13): the previous design called the 3rd-party
    # google/osv-scanner-action REUSABLE WORKFLOW, whose ONLY output path is a
    # SARIF upload to GitHub Code Scanning — which requires GHAS. On a private
    # Team-plan repo (no GHAS) that upload hard-fails, sinking the whole batch,
    # and the workflow exposes no input to disable it. Making the job opt-in
    # "fixed" the red by DELETING the CVE scan — the wrong trade.
    #
    # Correct fix: run the osv-scanner CLI directly. The CLI does the same OSV.dev
    # lockfile scan but reports to STDOUT and gates via its EXIT CODE — no SARIF,
    # no Code Scanning, no GHAS. So CVE detection is RESTORED as a hard gate and
    # works on any plan. This closes the gap dependency-review can't: a CVE newly
    # disclosed against an ALREADY-committed dependency (dependency-review only
    # inspects deps added in a PR diff).
    name: osv-scanner
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - name: Install osv-scanner CLI (pinned)
        env:
          OSV_VERSION: v2.3.8
        run: |
          set -euo pipefail
          url="https://github.com/google/osv-scanner/releases/download/${OSV_VERSION}/osv-scanner_linux_amd64"
          curl -sSfL "$url" -o /usr/local/bin/osv-scanner
          chmod +x /usr/local/bin/osv-scanner
          osv-scanner --version
      - name: Scan lockfiles against OSV.dev (gates on exit code)
        run: |
          set -uo pipefail
          # v2 syntax: the directory is the FINAL positional arg, AFTER flags
          # (`scan source --recursive .`). An earlier `-r --no-ignore ./` made the
          # walk start at "/" and report "No package sources found" — a scan of
          # NOTHING that still looked green. Capture output so we can tell "clean"
          # apart from "scanned nothing".
          # Exit codes: 0 = no vulns; 1 = vulns found (BLOCK); 128 = no package
          # sources found; other >1 = scan/infra error.
          set +e
          out="$(osv-scanner scan source --recursive --verbosity=info . 2>&1)"
          rc=$?
          set -e
          echo "$out"
          if [ "$rc" -eq 0 ]; then
            echo "osv-scanner: no known vulnerabilities in the scanned lockfiles."
          elif [ "$rc" -eq 1 ]; then
            echo "::error::osv-scanner found known vulnerabilities in committed dependencies. See log above; update the flagged packages."
            exit 1
          elif echo "$out" | grep -qi 'No package sources found'; then
            # The repo committed no lockfile (package-lock.json / requirements.txt
            # / go.sum / Cargo.lock / ...). There is genuinely nothing to scan —
            # NOT a clean bill of health. Pass the job (can't gate what isn't
            # there) but make the absence LOUD so it can't masquerade as coverage.
            echo "::warning::osv-scanner found NO package-source/lockfile to scan — dependency CVE coverage is effectively OFF for this repo. Commit a lockfile (e.g. package-lock.json) to enable it."
          else
            echo "::warning::osv-scanner exited $rc (scan/infra error, not a vuln verdict) — advisory this run. Re-run daily-batch to retry."
          fi

  daily-batch-result:
    name: Daily batch result
    runs-on: ubuntu-latest
    needs: [semgrep, perf-budget, license-check, osv-scanner]
    if: always()
    env:
      SEMGREP_RESULT: ${{ needs.semgrep.result }}
      PERF_RESULT: ${{ needs.perf-budget.result }}
      LICENSE_RESULT: ${{ needs.license-check.result }}
      OSV_RESULT: ${{ needs.osv-scanner.result }}
    steps:
      - name: Roll-up status
        run: |
          # osv-scanner is now a CLI job that gates on its own exit code (no GHAS
          # dependency), so it is back in the BLOCKING set alongside the others.
          status="success"
          for r in "$SEMGREP_RESULT" "$PERF_RESULT" "$LICENSE_RESULT" "$OSV_RESULT"; do
            case "$r" in
              success|skipped) ;;
              *) status="failure" ;;
            esac
          done
          echo "Daily batch status: $status (semgrep=$SEMGREP_RESULT perf=$PERF_RESULT license=$LICENSE_RESULT osv=$OSV_RESULT)"
          echo "$status" > daily-batch-status.txt
          [ "$status" = "success" ] || exit 1
      - name: Upload result
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: daily-batch-result
          path: daily-batch-status.txt
          retention-days: 30
