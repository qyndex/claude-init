name: Claude Security Review

# Anthropic's claude-code-security-review action. Multi-agent parallel security
# audit on every PR. Re-verifies each finding to filter false positives, and
# emits structured findings — this purpose-built scanner is the real value of
# the gate (diff-aware scoping + a separate refutation pass), which a generic
# claude-code-action prompt cannot replicate. We KEEP it.
# https://github.com/anthropics/claude-code-security-review
#
# IMPORTANT: pinned to a tagged release (never floating branch ref) per the
# Round 3 security audit M-S3 finding. If Anthropic publishes a new tag, bump
# it here with Renovate/Dependabot rather than auto-tracking trunk.
#
# CREDENTIAL NOTE (T-142, 2026-06-13): this action declares ONLY the
# `claude-api-key` input — it does NOT accept a Claude Code OAuth subscription
# token. We deliberately did NOT swap it for an OAuth claude-code-action prompt
# (that would forfeit diff-scoping, the separate false-positive pass, and SARIF
# output — the whole point of a gating security scanner). Instead the LLM scan
# DEGRADES GRACEFULLY: it runs only when ANTHROPIC_API_KEY is present, and skips
# with a visible warning when it is not. gitleaks + dependency-review run
# UNCONDITIONALLY (no Anthropic credential needed), so the job still enforces
# secret-scanning and dependency CVEs even on a token-only repo — and can pass.
# To make the LLM scan a hard gate, set the secret and add this job back to the
# branch ruleset's required checks: gh secret set ANTHROPIC_API_KEY.

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
    # e2e-audit ci-gates-6: gate cost scales with push count — scope to PRs
    # targeting main (same filter claude-review already had).
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pull-requests: write
  security-events: write

concurrency:
  group: claude-security-${{ github.event.pull_request.number || github.run_id }}
  cancel-in-progress: true

jobs:
  security-review:
    if: github.event.pull_request.draft == false
    runs-on: ubuntu-latest
    timeout-minutes: 25
    # `secrets` is NOT a valid context in a step-level `if:` (actionlint /
    # GitHub reject the whole workflow file). Resolve the secret's presence to a
    # job-level env var here — env IS allowed in step `if:` — and gate on it.
    env:
      HAS_KEY: ${{ secrets.ANTHROPIC_API_KEY != '' }}
    steps:
      - name: Preflight — note LLM-scan credential status (T-142)
        run: |
          if [ "$HAS_KEY" = "true" ]; then
            echo "ANTHROPIC_API_KEY present — the claude-code-security-review LLM scan will run."
          else
            echo "::warning::ANTHROPIC_API_KEY absent — the LLM security scan will be SKIPPED. gitleaks + dependency-review still run and gate this PR. claude-code-security-review accepts ONLY an API key (a subscription OAuth token is not enough). To enable the full scan: gh secret set ANTHROPIC_API_KEY. To make it a hard merge gate, also add 'security-review' to the branch ruleset required checks."
          fi

      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0

      - name: Anthropic security review
        # Runs only when the API key is configured — degrades gracefully on
        # token-only repos rather than failing the whole job. gitleaks +
        # dependency-review below still gate the PR unconditionally.
        if: env.HAS_KEY == 'true'
        # Pinned tag — bump via Renovate/Dependabot. Never use a floating branch ref.
        # If a stable tag isn't published yet, pin to a commit SHA:
        #   uses: anthropics/claude-code-security-review@<40-char SHA>
        uses: anthropics/claude-code-security-review@0c6a49f1fa56a1d472575da86a94dbc1edb78eda # no stable tag published; pinned to main HEAD SHA
        with:
          # Input names per the pinned action.yml: claude-api-key + claude-model
          # (the previous anthropic_api_key/model were never declared inputs).
          claude-api-key: ${{ secrets.ANTHROPIC_API_KEY }}
          claude-model: claude-opus-4-8

      # Gitleaks via the CLI, NOT gitleaks/gitleaks-action@v2 (T-143 / FINDING-17,
      # live-e2e 2026-06-13). The marketplace action requires a paid
      # GITLEAKS_LICENSE secret on ANY repo owned by a GitHub ORGANIZATION — it
      # hard-exits "is an organization. License key is required." and fails the
      # whole job, with nothing leaked. The CLI is the same scanner under the
      # same MIT licence with no key for any account type. Pinned by version.
      - name: Gitleaks (CLI — no org licence; T-143)
        env:
          GITLEAKS_VERSION: 8.30.1
        run: |
          set -euo pipefail
          url="https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"
          curl -sSfL "$url" -o /tmp/gitleaks.tgz
          tar -xzf /tmp/gitleaks.tgz -C /tmp gitleaks
          # Full git-history scan; --exit-code 1 (the default) fails the gate on
          # any finding, --redact keeps the secret value out of the run log.
          /tmp/gitleaks git --redact --exit-code 1

      - name: Dependency review
        if: github.event_name == 'pull_request'
        uses: actions/dependency-review-action@v4
        with:
          fail-on-severity: high
