name: Claude Security Review

# Security audit on every PR — runs as a claude-code-action@v1 prompt so it can
# authenticate with EITHER a subscription OAuth token (claude setup-token) OR a
# metered ANTHROPIC_API_KEY. This replaces the dedicated
# anthropics/claude-code-security-review action, which declared ONLY a
# `claude-api-key` input and therefore could never pass on a subscription-token-
# only repo (T-142 / FINDING-7, live-e2e 2026-06-12).
#
# Tradeoff (recorded so it isn't lost): the purpose-built scanner did diff-aware
# finding extraction + dedup + structured SARIF/PR annotations out of the box.
# The prompt approach is a general agent told to find vulnerabilities in the
# diff — capable, but the structure is enforced by the prompt + the format-lint
# step below, not by the action. If a future revision wants the dedicated
# scanner back, it needs an ANTHROPIC_API_KEY secret and the OAuth path is lost.
#
# The job name (security-review) is unchanged so the branch ruleset's required
# status check keeps matching. id-token: write is required for the OIDC->App
# token exchange the OAuth path uses (same as claude-review.yml / pr-review.yml).

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
    # e2e-audit ci-gates-6: gate cost scales with push count — scope to PRs
    # targeting main (same filter claude-review already had).
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pull-requests: write
  security-events: write
  id-token: write # OIDC -> Claude GitHub App token exchange (OAuth path)

concurrency:
  group: claude-security-${{ github.event.pull_request.number || github.run_id }}
  cancel-in-progress: true

jobs:
  security-review:
    if: github.event.pull_request.draft == false
    runs-on: ubuntu-latest
    timeout-minutes: 25
    steps:
      - name: Preflight — Anthropic credential present (e2e-audit ci-gates-4)
        env:
          HAS_KEY: ${{ secrets.ANTHROPIC_API_KEY != '' }}
          HAS_TOKEN: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN != '' }}
        run: |
          if [ "$HAS_KEY" != "true" ] && [ "$HAS_TOKEN" != "true" ]; then
            echo "::error::No Anthropic credential — this GATING security review can never pass. Fix: gh secret set CLAUDE_CODE_OAUTH_TOKEN (from 'claude setup-token', Pro/Max subscription) or gh secret set ANTHROPIC_API_KEY (metered API). setup.sh and harness-doctor both check this."
            exit 1
          fi

      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.pull_request.head.sha }}
          fetch-depth: 0

      - name: Run Claude security review (OAuth or API key)
        uses: anthropics/claude-code-action@v1
        with:
          # Subscription OAuth token ('claude setup-token') or metered API key —
          # an empty secret resolves to unset; the action uses whichever is set.
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          # Opus for the deepest security reasoning (this is a gating audit, not
          # the cross-model code review). v1 takes model via claude_args.
          claude_args: "--model claude-opus-4-8"
          prompt: |
            You are the security agent (.claude/agents/quality/security.md).
            Perform a security audit of THIS PULL REQUEST'S DIFF ONLY — do not
            flag pre-existing issues outside the changed lines.

            Scope (OWASP LLM/web Top 10 + the constitution's guardrails):
            injection (SQL/command/path/template), authn/authz gaps, secret or
            credential exposure, SSRF, insecure deserialization, missing input
            validation, unsafe shell (eval, curl|sh, command interpolation),
            permission/sandbox regressions, and dependency risk.

            Multi-pass (re-verify to suppress false positives):
            1. Read the diff.
            2. Read the full surrounding code for each changed hunk.
            3. Form findings, severity-tagged (critical/high/medium/low/info).
            4. Re-verify each finding by re-reading the relevant path — drop
               anything you cannot substantiate at a concrete path:line.
            5. Post the surviving findings as inline PR review comments.

            FORMAT CONTRACT (machine-checked): every finding MUST cite
            `path:line`. End your summary with the exact line:
            `Security: re-verified <N> findings, suppressed <M> false positives.`

            Block the PR (--request-changes) if any critical or high remains.

      # Mechanical proxy that the audit ran and re-verified — the posted review
      # must carry the marker and per-finding file:line citations. Warn-only so
      # prompt drift doesn't hard-block merges, but visible in the checks UI.
      - name: Lint security review format (citations + marker)
        if: always()
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: |
          reviews=$(gh pr view "$PR_NUMBER" --json reviews -q '.reviews[].body' 2>/dev/null || true)
          [ -z "$reviews" ] && { echo "no review body yet — skipping format lint"; exit 0; }
          if ! echo "$reviews" | grep -qE 'Security: re-verified [0-9]+ findings'; then
            echo "::warning::Security review output lacks the re-verification marker — pass-2 not evidenced."
          fi
          if ! echo "$reviews" | grep -qE '[A-Za-z0-9_./-]+\.[a-z]+:[0-9]+'; then
            echo "::warning::Security review findings carry no path:line citations."
          fi
          echo "security review format lint done"

      - name: Gitleaks
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        continue-on-error: false

      - name: Dependency review
        if: github.event_name == 'pull_request'
        uses: actions/dependency-review-action@v4
        with:
          fail-on-severity: high
