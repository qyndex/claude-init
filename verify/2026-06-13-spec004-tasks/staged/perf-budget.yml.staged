name: Perf Budget

# Enforces commit-time performance budgets per slo.yml.
# For frontend: bundle size + Lighthouse.
# For backend: k6 quick-load test against staging.

on:
  workflow_call:
  workflow_dispatch:

permissions:
  contents: read
  pull-requests: write

jobs:
  # FINDING-24 (live-e2e 2026-06-13): the job-level `if: hashFiles(...)` was
  # invalid — hashFiles is unavailable in a job `if:`, only in step contexts —
  # so as a reusable workflow (called by daily-batch) this failed to PARSE,
  # which made `gh workflow run daily-batch.yml` 422 and blocked check-daily-batch.
  # Detect the sentinel file after checkout and gate the remaining steps on it.
  bundle-budget:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - id: detect
        # FINDING-31 (live-e2e 2026-06-14): the bundle budget only applies to a
        # project that actually BUILDS a frontend bundle. A backend-only app
        # (e.g. an Express API) has package.json but NO `build` script, so the
        # old `npm run build` hard-failed with "Missing script: build" and sank
        # daily-batch. Gate on the presence of a build script, not just
        # package.json.
        run: |
          if [ -f package.json ] && node -e "process.exit(require('./package.json').scripts?.build?0:1)" 2>/dev/null; then
            echo "exists=1" >> "$GITHUB_OUTPUT"
          else
            echo "exists=0" >> "$GITHUB_OUTPUT"
            echo "no package.json build script — skipping bundle budget (backend-only or non-Node project)"
          fi
      - uses: actions/setup-node@v4
        if: steps.detect.outputs.exists == '1'
        with: { node-version-file: 'package.json' }
      - if: steps.detect.outputs.exists == '1'
        run: |
          if [ -f pnpm-lock.yaml ]; then corepack enable && pnpm install --frozen-lockfile && pnpm build
          else npm ci && npm run build
          fi
      - name: Bundle size check
        if: steps.detect.outputs.exists == '1'
        run: |
          # Largest JS bundle must be < 200KB gzipped per slo.yml T1 default
          max_kb=200
          actual=$(find dist build .next/static -name '*.js' 2>/dev/null | xargs -I{} sh -c 'gzip -c "{}" | wc -c' | sort -n | tail -1)
          actual_kb=$((actual / 1024))
          echo "Largest bundle: ${actual_kb}KB (max: ${max_kb}KB)"
          if [ "$actual_kb" -gt "$max_kb" ]; then
            echo "::error::Bundle size ${actual_kb}KB exceeds budget ${max_kb}KB"
            exit 1
          fi

  api-perf:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - id: detect
        run: |
          if [ -f pyproject.toml ] || [ -f go.mod ]; then echo "exists=1" >> "$GITHUB_OUTPUT"; else echo "exists=0" >> "$GITHUB_OUTPUT"; echo "no pyproject.toml/go.mod — skipping api perf"; fi
      - if: steps.detect.outputs.exists == '1'
        run: |
          # k6 quick load test against staging endpoint
          # configure per project; this is the template
          echo "Stub: configure k6 script per service in perf/"
