# Claude Code per-user settings (overrides team-shared settings.json)
.claude/settings.local.json
.claude/hooks/.log/

# Round 10 B: verify/ evidence — commit the lightweight, reviewable trail
# (EVIDENCE.md, results.json, per-AC screenshots, API-trace JSON, red/green ledger)
# so the operator sees proof in the PR diff and it survives worktree teardown.
# CI-artifact the heavy binaries instead of bloating the repo.
verify/**/*.webm
verify/**/*.zip
verify/**/network.har
verify/**/html-report/
verify/**/test-results/
.claude/state/image-spend.jsonl

# Round 13 Fix 2: runtime concurrency state — lock dirs (with-lock.sh) + the
# overnight run-lock (local-overnight-build.sh). Machine-written, never committed.
.claude/state/locks/
.claude/state/overnight-*.run
# per-machine scheduled-task install record (install-overnight-tasks.sh; doctor reads it)
.claude/state/routines-installed

# Per-developer auto-memory (Claude Code v2.1.59+ writes to ~/.claude/projects/...)
# nothing to gitignore here

# Swarm runtime state — coordinator fleet + per-stream working files dirty the tree
# on every dispatch. Templates and decisions.log are tracked; runtime state is not.
.swarms/coordinator/fleet.json
.swarms/coordinator/workflow-state.json
.swarms/streams/*
!.swarms/streams/.gitkeep
# Typed lane events (JSONL) emitted per swarm stream — runtime telemetry (AC-17)
.swarms/events/

# Workspace-fingerprinted session heartbeats — per-worktree runtime state (AC-18)
.claude/sessions/

# Auto-managed memory scratchpads — short-term, machine-written
# in-flight briefs: rewritten by session-end.sh at every exit and cleared at the
# next start — tracking them keeps the tree perpetually dirty (incl. stale-* copies)
.claude/memory/in-flight*.md
.claude/memory.proposed/in-flight*.md
.claude/memories/.*
.claude/memories/checkpoints/
.claude/memories/active/
.claude/memories/archive/
.claude/memories/instincts/observations.jsonl

# Native worktrees (created by `claude -w <name>`)
.claude/worktrees/

# Overnight reports
OVERNIGHT_REPORT.md
overnight-report-*.md

# Secrets / env
.env
.env.*
!.env.example
*.pem
*.key
*_rsa
id_rsa*
*credentials*
*.tfvars

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn-integrity

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/

# Rust
target/
Cargo.lock.bak

# Go
*.test
*.prof
vendor/

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/

# Editor / OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test / coverage
coverage/
playwright-report/
test-results/

# Logs — ALL .log files are ignored, including nested (operator directive 2026-05-29)
# EXCEPT the TDD ledger's red/green evidence (e2e-audit P2.1 decision, 2026-06-12):
# evidence-gate binds AC proof to the reviewed commit, so the Round-10-B
# "committed lightweight trail" needs exactly these two filenames in the PR diff.
*.log
**/*.log
!verify/**/red.log
!verify/**/green.log
logs/

# Temporary
tmp/
.tmp/
.claude/state/silent-failure-audit.json
.claude/state/sweep-remaining.tsv
# Operator-only marker: presence lets verify.sh honor SKIP_* gate bypasses (Spec 003 AC-1). Must never be committed.
.claude/state/allow-skip-gates
.claude/state/allow-adopt-approve
.claude/state/ruleset-applied
# Initiative/spec attribution pointers — rewritten by initiative-state.sh at every
# network boundary; runtime state (the tracked STATE.md carries the history)
.claude/state/current-initiative
.claude/state/current-spec
# verify.sh SKIP-request audit log (Spec 003 AC-2)
verify/.skip-log
.claude/state/context-monitor/
.claude/state/read-nudge/
.claude/state/ideation-pending
.claude/state/stop-verify-blocks.log
# Loop-control runtime telemetry (e2e-audit autopilot-2/5) — machine-written
.claude/state/tasks-md.snapshot
.claude/state/task-status-notes.log

# Brownfield adoption backup (reconcile-claude-dir.sh — holds settings.local.json, never commit)
.brownfield-backup/

# Per-session local-state mirror — machine + absolute-path specific, binary tarball, regenerated every session
.claude/.user-state-mirror/
# Skill-router runtime cache — rebuilt from skill frontmatter on demand
.claude/state/skill-triggers.tsv
# Operational ruleset backups taken before a live gate change (point-in-time, not source)
.claude/state/ruleset-*-backup-*.json
# Metabolism / dream regenerated aggregates — memory.proposed is a review staging area, not committed source
.claude/memory.proposed/atlas/
.claude/memory.proposed/dora/
.claude/memory.proposed/rollups/
.claude/memory.proposed/decisions/
# Dream-run instinct-extraction reports (machine-written verify output)
verify/*-instinct-extraction/
