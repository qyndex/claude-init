@@ -93,10 +93,32 @@ if [ -n "$last_brief" ]; then
   fi
 fi
 
+# ─── M-05b: boot auto-heal (self-healing current state) ─────────────────
+# Boot used to only WARN on stale state; now it HEALS. Deterministic sync +
+# index rebuild run inline (<2s measured: ~0.2s + ~1.1s). Gated to once per day
+# via a dated cache marker so (a) boot stays fast and (b) the tracked STATE.md /
+# index.jsonl churn is bounded to daily, not every session — keeping the
+# stop-verify git-clean gate viable (O-7 second-order concern). The atlas is
+# heavier, so it is BACKGROUNDED below (not inline). All calls exec/grep-gated →
+# no-ops in an unadopted tree.
+mkdir -p .claude/memory/.cache 2>/dev/null || true
+heal_marker=".claude/memory/.cache/boot-heal-$(date +%Y%m%d)"
+if [ ! -f "$heal_marker" ]; then
+  # Sync must land AFTER the ledger is correct (M-07) or it rewrites STATE.md
+  # with the same wrong content + a fresh timestamp — hence M-05b deps M-07-*.
+  [ -x .claude/scripts/initiative-state.sh ] \
+    && bash .claude/scripts/initiative-state.sh sync >/dev/null 2>&1 || true
+  [ -x .claude/scripts/memory-index.sh ] \
+    && bash .claude/scripts/memory-index.sh rebuild >/dev/null 2>&1 || true
+  # Mark healed for today even if a sub-step failed — a broken script must not
+  # make every boot re-attempt (and re-dirty the tree) all day.
+  touch "$heal_marker" 2>/dev/null || true
+fi
+
 # ─── Initiative living state (memory-system review §7.2) ────────────────
 # One line: id, phase, task counts, freshness — the always-current answer to
 # "where is this initiative?". Generated by initiative-state.sh sync at
-# network boundaries; `show` only reads.
+# network boundaries (and the boot auto-heal above); `show` only reads.
 if [ -x .claude/scripts/initiative-state.sh ]; then
   # JUSTIFIED: best-effort injection — a failing show (no STATE.md yet) yields empty and the line is omitted
   init_line=$(bash .claude/scripts/initiative-state.sh show 2>/dev/null || true)
@@ -177,8 +199,19 @@ if [ -f .claude/memory/atlas/manifest.json ] && command -v jq >/dev/null 2>&1; t
   [ -n "$current_sha" ] && [ -n "$atlas_sha" ] && [ "$atlas_sha" != "$current_sha" ] && stale_reason="atlas indexed at a different commit"
 
   if [ -n "$stale_reason" ]; then
+    # M-05b: heal, don't just warn. The atlas refresh is heavier than the inline
+    # sync/rebuild above, so BACKGROUND it (detached; boot never blocks on it).
+    # Once-per-day gated by the same dated marker family so a stale atlas isn't
+    # re-refreshed on every boot. The warning still shows this session (the
+    # backgrounded refresh lands for the NEXT boot).
+    atlas_marker=".claude/memory/.cache/boot-atlas-$(date +%Y%m%d)"
+    if [ -x .claude/scripts/atlas-refresh.sh ] && [ ! -f "$atlas_marker" ]; then
+      touch "$atlas_marker" 2>/dev/null || true
+      # JUSTIFIED: fully detached (stdin/out/err closed, backgrounded) so the hook returns immediately; nohup keeps it alive past hook exit
+      nohup bash .claude/scripts/atlas-refresh.sh >/dev/null 2>&1 &
+    fi
     # Gap-audit G21: no /atlas command exists — the script is the only real path
-    ctx_parts+=("⚠ ATLAS STALE ($stale_reason) — run \`bash .claude/scripts/atlas-refresh.sh\`.")
+    ctx_parts+=("⚠ ATLAS STALE ($stale_reason) — refreshing in background; run \`bash .claude/scripts/atlas-refresh.sh\` to force.")
   else
     ctx_parts+=("[atlas] Web: $atlas_web | API: $atlas_api | ORM: $atlas_orm | Updated: ${atlas_updated%%T*}. Read .claude/memory/atlas/{STACK,STRUCTURE,KNOWN_ENTRIES}.md for full details.")
 
